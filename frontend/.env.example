# --- Supabase ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of this site — no trailing slash.
#
# Every OAuth and email-link round-trip is told to come back here. Leave it
# unset and the app uses whatever origin the browser is on, which means anyone
# who lands on the raw *.vercel.app deployment URL gets logged in there and
# stays there. Set it in the PRODUCTION environment to the real domain:
#
#   NEXT_PUBLIC_SITE_URL=https://cohorts.rockpaperscissors.studio
#
# Leave it unset on preview deployments so each preview redirects to itself.
#
# This must match the Supabase dashboard (Authentication → URL Configuration):
#   Site URL:       https://cohorts.rockpaperscissors.studio
#   Redirect URLs:  https://cohorts.rockpaperscissors.studio/**
# If a redirectTo is not on that allow-list, Supabase silently ignores it and
# sends the user to Site URL instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Transactional email (Resend) ---
# Sends the "You're in" confirmation when someone takes a workshop seat.
# Leave RESEND_API_KEY unset and nothing is sent — enrolling still works, and
# each skipped mail is logged. That is the intended state for local dev and
# preview deployments; set it in PRODUCTION only.
#
# Setup, once:
#   1. resend.com → API Keys → create one with Sending access. It starts "re_".
#   2. Domains → add rockpaperscissors.studio and add the DKIM/SPF records it
#      gives you to DNS. Resend refuses any From on an unverified domain.
#   3. Put the key in Vercel → Settings → Environment Variables (Production).
#
# SERVER ONLY — no NEXT_PUBLIC_ prefix, or the key ships to the browser.
RESEND_API_KEY=

# Who the confirmation comes from. Must be on the domain verified in step 2.
MAIL_FROM=RPS Cohorts <cohorts@rockpaperscissors.studio>
# Where replies land — a mailbox somebody actually reads.
MAIL_REPLY_TO=cohorts@rockpaperscissors.studio

# --- Registrations sheet (Google Apps Script) ---
# Mirrors every registration into the team's Google Sheet, so the list can be
# read without a Supabase login. Supabase stays the source of truth.
#
# Leave SHEETS_WEBHOOK_URL unset and nothing is written — registering still
# works, and each skipped row is logged. That is the intended state for local
# dev and previews; set it in PRODUCTION only, or test registrations land in
# the real list.
#
# Setup: paste scripts/registrations-sheet.gs into the sheet
# (Extensions -> Apps Script), set its SECRET, deploy it as a Web app, then put
# the /exec URL and the same SECRET here. Full steps are in that file's header.
#
# SERVER ONLY — no NEXT_PUBLIC_ prefix, or anyone could write to the sheet.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# --- Who can see the registration list ---
# /admin/registrations shows every registrant's name, email and WhatsApp number.
# Comma-separated addresses; anyone else gets a 404, signed in or not.
#
# Unset, it falls back to dheena@rockpaperscissors.studio alone — one known
# person rather than nobody, so the page is never locked out and never open.
#
# SERVER ONLY — no NEXT_PUBLIC_ prefix, or the list of who is privileged ships
# to every browser.
ADMIN_EMAILS=dheena@rockpaperscissors.studio
