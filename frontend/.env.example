# --- Supabase ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of this site — no trailing slash.
#
# Every OAuth and email-link round-trip is told to come back here. Leave it
# unset and the app uses whatever origin the browser is on, which means anyone
# who lands on the raw *.vercel.app deployment URL gets logged in there and
# stays there. Set it in the PRODUCTION environment to the real domain:
#
#   NEXT_PUBLIC_SITE_URL=https://cohorts.rockpaperscissors.studio
#
# Leave it unset on preview deployments so each preview redirects to itself.
#
# This must match the Supabase dashboard (Authentication → URL Configuration):
#   Site URL:       https://cohorts.rockpaperscissors.studio
#   Redirect URLs:  https://cohorts.rockpaperscissors.studio/**
# If a redirectTo is not on that allow-list, Supabase silently ignores it and
# sends the user to Site URL instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
